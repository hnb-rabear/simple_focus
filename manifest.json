{
  "manifest_version": 3,
  "name": "Simple Focus",
  "version": "1.0.0",
  "description": "Daily time limit for each website, synced across your PCs.",
  "key": "",
  "permissions": ["storage", "tabs", "alarms", "idle"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "options.html" },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
